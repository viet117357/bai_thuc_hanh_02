#include<stdio.h>
#include<stdlib.h>
typedef struct {
	char hoten[30];
	int masv;
	float d1,d2,d3;
}Sinhvien;
void nhap(Sinhvien *p, int n){
	int i;
	for(i = 0; i<n; i++){
		printf("\n Sinh vien thu %d: \n", i + 1);
		getchar();
		printf("Ho ten: ");
		fgets(p[i].hoten, sizeof(p[i].hoten), stdin);
		printf("Ma sinh vien: ");
		scanf("%d", &p[i].masv);
		printf("Diem 1: ");
		scanf("%f", &p[i].d1);
		printf("Diem 2: ");
		scanf("%f", &p[i].d2);
		printf("Diem 3: ");
		scanf("%f", &p[i].d3);
	}
}
void in(Sinhvien *p, int n){
	int i;
	printf("\n...Danh sach sinh vien bao gom...\n");
	for(i = 0; i<n; i++){
		printf("\n Sinh vien thu %d: \n", i + 1);
		printf("Ho ten: %s\n", p[i].hoten);
		printf("Ma sinh vien: %d\n", p[i].masv);
		printf("Diem 1: %.2f\n", p[i].d1);
		printf("Diem 2: %.2f\n", p[i].d2);
		printf("Diem 3: %.2f\n", p[i].d3);
	}
}
int main(){
	int n;
	printf("nhap so luong sinh vien: ");
	scanf("%d", &n);
	Sinhvien *p;
	p = (Sinhvien*)malloc(n*sizeof(Sinhvien));
	if(p == NULL){
		printf("ko du bo nho");
		return 1;
	}
	nhap(p, n);
	in(p, n);
	free(p);
	return 0;
}
